---
import { ArrowRight, CircleAlert, Code, Mail, Users } from "@lucide/astro";
import HeroSection from "../components/HeroSection.astro";
import MainLayout from "../layouts/MainLayout.astro";

const contactItems = [
  {
    title: "Email us",
    description: "Drop us a message at info@onedata.org.",
    action: "Send email",
    href: "mailto:info@onedata.org",
    color: "from-red-500 to-orange-500",
    gradientStart: "#ef4444",
    gradientEnd: "#f97316",
    icon: Mail,
  },
  {
    title: "Onedata source code",
    description:
      "For our latest developments and updates, view the source code on GitHub or the changelog. If you find our project useful, please consider starring it on GitHub.",
    action: "View on GitHub",
    href: "https://github.com/onedata/onedata",
    gradientStart: "#f43f5e",
    gradientEnd: "#ef4444",
    icon: Code,
  },
  {
    title: "Bug reports and discussions",
    description:
      "Use GitHub to create an issue for any bugs or feature discussions.",
    action: "Create an issue",
    href: "https://github.com/onedata/onedata/issues",
    gradientStart: "#f97316",
    gradientEnd: "#f59e0b",
    icon: CircleAlert,
  },
  {
    title: "Dedicated support",
    description:
      "Organizations using Onedata may apply for dedicated support including configuring and performance tuning, implementing additional features, and solving problems.",
    action: "Get in touch",
    href: "mailto:info@onedata.org",
    gradientStart: "#dc2626",
    gradientEnd: "#fb7185",
    icon: Users,
  },
];
---

<MainLayout
  title="Contact – Onedata"
  description="Multiple ways to reach the Onedata team and get the support you need."
>
  <div class="contact-page">
    <HeroSection
      title="Get in touch"
      description="Multiple ways to reach us and get the support you need."
    />

    <div class="contact-inner container">
      <div class="contact-list">
        {
          contactItems.map((item) => (
            <div class="contact-card z-10">
              <div
                class="contact-icon"
                style={`background: linear-gradient(135deg, ${item.gradientStart}, ${item.gradientEnd})`}
              >
                {<item.icon class="h-6 w-6 text-white" />}
              </div>
              <div class="contact-card-body">
                <h3 class="contact-card-title">{item.title}</h3>
                <p class="contact-card-desc">{item.description}</p>
                <a
                  href={item.href}
                  class={`contact-action no-external-icon`}
                  target={item.href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    item.href.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {item.action}
                  <ArrowRight class="h-4 w-4" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .contact-page {
    background-color: var(--od-bg);
    min-height: 100vh;
  }

  .contact-inner {
    max-width: 56rem;
    margin: 0 auto;
    margin-bottom: 4rem;
    margin-top: 1.5rem;
  }

  .contact-hero {
    margin-bottom: 3.5rem;
  }

  .contact-title {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 700;
    color: var(--od-text);
    margin-bottom: 0.75rem;
  }

  .contact-subtitle {
    font-size: 1.125rem;
    color: var(--od-text-muted);
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-card {
    background: var(--od-bg-card);
    border: 1px solid var(--od-border);
    border-radius: 1rem;
    padding: 2rem;
    display: flex;
    gap: 1.5rem;
    transition: box-shadow 0.2s;
  }

  .contact-card:hover {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .contact-icon {
    display: inline-flex;
    padding: 0.75rem;
    border-radius: 0.75rem;
    opacity: 0.9;
    flex-shrink: 0;
    align-self: flex-start;
  }

  .contact-card-body {
    flex: 1;
  }

  .contact-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--od-text);
    margin-bottom: 0.5rem;
  }

  .contact-card-desc {
    color: var(--od-text-muted);
    margin-bottom: 1rem;
    line-height: 1.65;
  }

  .contact-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--od-accent);
    transition: opacity 0.2s;
    text-decoration: none;
  }

  .contact-action:hover {
    opacity: 0.75;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .contact-card {
      flex-direction: column;
    }
  }
</style>
