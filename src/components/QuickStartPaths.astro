---
import {
  Globe,
  Server,
  Box,
  AlertTriangle,
  Info,
  CheckCircle,
  MousePointerClick,
  Clipboard,
  ClipboardCopy,
  PackageOpen,
} from "lucide-astro";
import { marked } from "marked";

const paths = [
  {
    id: "online",
    icon: Globe,
    label: "Try It Online",
    sublabel: "No setup required",
    steps: [
      {
        number: "01",
        title: "Open the demo environment",
        description:
          "Go to [demo.onedata.org](https://demo.onedata.org) — a publicly accessible zone, which you can use to familiarize yourself with the system if your don't have access to any Onedata services. You will need an account in [EGI](https://www.egi.eu/services/) or Google for that purpose. If you don't have one, [contact us](/contact) and we will create a test account for you.",
      },
      {
        number: "02",
        title: "Log in",
        description:
          "Click on the selected identity provider and follow the steps to log in to Onedata. You will have to accept releasing your user information so that you can be authenticated by the Onezone service.",
        note: "The green key icon is reserved for the login of administrators and special users created through the Onepanel administrative interface. Regular users should use social or institutional accounts to sign in.",
      },
      {
        number: "03",
        title: "Explore the Sandbox Space",
        description:
          "All users logging in to [demo.onedata.org](https://demo.onedata.org) are granted access to the Sandbox Space. It's a perfect place to play around with Onedata and test its features.",
        note: `If you have logged in to [demo.onedata.org](https://demo.onedata.org) and you don't see the **Sandbox** space in the **DATA** tab, it's possible that you don't belong to the **All users group**. It may happen if you have opted-out of the group or logged into the system in the past, when the Sandbox was not set up yet. To fix it, join the group manually as described in <a href="/docs/25/user-guide/quickstart#sandbox" target="_blank">the documentation</a>.`,
        warning: `The **Sandbox** space is intended to be a testing environment and comes with no guarantees. It is cleaned if it becomes cluttered.

Do not store any private or sensitive data in the space, as it's available to all the logged-in users.`,
      },
      {
        number: "04",
        title: "Create your own private directory",
        description: `Navigate to the **DATA → Sandbox → Files** tab and create a new directory using the action in the top right corner or by invoking the right-click menu.
          
Right-click on the newly created directory and choose **Permissions** from the context menu. Switch to the **ACL** permission type and add a single entry, for yourself, allowing all operations.

Hit **Save** and done — you now have your own directory in the Sandbox Space, to which no one else has access (<a class="no-external-icon" href="/docs/25/user-guide/data#access-control-lists" target="_blank">ACLs</a> implicitly deny access if there is no explicitly allowing entry). You may use this directory to <a class="no-external-icon" href="/docs/25/user-guide/interfaces/web-file-browser#uploading-data" target="_blank">upload some data</a> and test Onedata features. If you wish for others to see the fruits of your experiments, feel free to place your data in a non-ACL-secured location.`,
      },
      {
        number: "05",
        title: "Mount with Oneclient (optional)",
        description: `For POSIX access, <a class="no-external-icon" href="/docs/25/user-guide/interfaces/oneclient/#installation" target="_blank">install the Oneclient</a> on any Linux machine and run:`,
        code: "oneclient --host demo.onedata.org --token <your-access-token> ~/onedata",
        note: 'Generate an access token in the Onezone web interface choosing the **TOKENS → "plus" icon on the sidebar\'s top → Oneclient Access**.',
      },
    ],
  },
  {
    id: "vms",
    icon: Server,
    label: "Deploy on VMs",
    sublabel: "Full control on your own servers",
    steps: [
      {
        number: "01",
        title: "Check system requirements",
        description:
          "Ensure your virtual machines meet the minimum requirements before proceeding.",
        options: [
          {
            icon: Server,
            label: "Onezone VM",
            text: "4 vCPU, 12 GB RAM, 20 GB SSD disk. Requires a publicly reachable IP and a valid DNS name. Onezone communicates with external services or clients using ports 53, 80, 443 and 9443. All of these ports need to be publicly open except 9443 which is used for direct emergency access to the Onezone.",
          },
          {
            icon: Server,
            label: "Oneprovider VM",
            text: "4 vCPU, 16 GB RAM, 50 GB SSD disk + 8 MB per 1,000 files.",
          },
          {
            icon: CheckCircle,
            label: "OS",
            text: "Any Linux OS supporting Docker; however, the recommended choice is Ubuntu 20.04 LTS or newer, as it has been thoroughly tested.",
          },
          {
            icon: PackageOpen,
            label: "Software installed on VMs",
            text: "Git, Docker, Docker Compose, Python + PyYAML",
          },
        ],
      },
      {
        number: "02",
        title: "Get Onezone deployment scripts",
        description:
          "Pull the `onedata-deployments` repository containing ready-to-use templates to set up your own Onezone instance.",
        code: "git clone https://github.com/onedata/onedata-deployments.git",
      },
      {
        number: "03",
        title: "Configure the Onezone deployment",
        description:
          "Navigate to the `onedata-deployments/onezone/examples/batch-mode` directory and examine the `ONEZONE_CONFIG` section of `docker-compose.yml`. Fill in the desired values (name, domain).",
      },
      {
        number: "04",
        title: "Configure authorization methods",
        description: `Prepare and place your \`auth.config\` in \`onedata-deployments/onezone/examples/batch-mode/data/secret/auth.config\`. You can use the example below to setup a username & password sign-in.
 
For full reference, read [the Login methods documentation](/docs/25/admin-guide/onezone/configuration/oidc-saml).`,
        code: `#{
    version => 3,

    % Allows to log in to Onezone using username & password.
    basicAuthConfig => #{
        enabled => true
    },

    supportedIdps => [
        % basicAuth is a special IdP id reserved for signing in with username & password 
        % and the only valid config entry using the basicAuth protocol.
        {basicAuth, #{
            protocol => basicAuth
        }},
    ]
}`,
      },
      {
        number: "05",
        title: "Set the emergency password (optional)",
        description: `You can set a password of your choice for accessing the emergency panel before starting the deployment. Otherwise, it will be generated automatically.
          
In order to do that, create the \`onedata-deployments/onezone/examples/batch-mode/data/secret/emergency-passphrase.txt\` file with the password written as a plain text.`,
      },
      {
        number: "06",
        title: "Deploy Onezone",
        description:
          "Run the Onezone Docker Compose installation script. The installation should happen automatically and might take a while (consult container logs for indication whether the installation was finished).",
        code: "./onezone.sh start",
      },
      {
        number: "07",
        title: "Visit Onezone in your browser",
        description:
          "Open `https://<your-domain>` as configured in step 3 and log in using the `admin` user and the password found in `data/secret/emergency-passphrase.txt`.",
      },
      {
        number: "08",
        title: "Add Oneprovider",
        description: "Coming soon",
      },
    ],
  },
  {
    id: "k8s",
    icon: Box,
    label: "Deploy on Kubernetes",
    sublabel: "Cloud-native, scalable setup",
    steps: [
      {
        number: "01",
        title: "Prepare your cluster",
        description:
          "Make sure your Kubernetes cluster meets the prerequisites before installing Onedata Helm charts.",
        options: [
          {
            icon: CheckCircle,
            label: "Kubernetes",
            text: "Version ≥ 1.24. Tested with GKE, EKS, AKS and bare-metal kubeadm clusters.",
          },
          {
            icon: CheckCircle,
            label: "Helm",
            text: "Helm 3.x must be installed and configured to reach your cluster.",
          },
          {
            icon: CheckCircle,
            label: "Ingress & TLS",
            text: "An Ingress controller (e.g. nginx-ingress) and a cert-manager ClusterIssuer for automatic TLS are required.",
          },
        ],
      },
      {
        number: "02",
        title: "Add the Onedata Helm repository",
        description: "Add the official chart repository and update it:",
        code: "helm repo add onedata https://onedata.github.io/charts\nhelm repo update",
      },
      {
        number: "03",
        title: "Install Onezone",
        description:
          "Create a values file for Onezone and deploy it to your cluster:",
        code: "# onezone-values.yaml\nonezone:\n  domain: onezone.example.com\n  tls:\n    issuer: letsencrypt-prod\n\nhelm install onezone onedata/onezone \\\n  -f onezone-values.yaml \\\n  --namespace onedata --create-namespace",
        note: "The domain must resolve to your Ingress controller's external IP before installation.",
      },
      {
        number: "04",
        title: "Install Oneprovider",
        description:
          "Deploy one or more Oneprovider instances, pointing them at your Onezone:",
        code: "# oneprovider-values.yaml\noneprovider:\n  onezoneUrl: https://onezone.example.com\n  domain: oneprovider.example.com\n  storage:\n    type: posix          # or s3, ceph, nfs …\n    path: /mnt/data\n\nhelm install oneprovider onedata/oneprovider \\\n  -f oneprovider-values.yaml \\\n  --namespace onedata",
      },
      {
        number: "05",
        title: "Register, create a Space and go",
        description:
          "Open https://onezone.example.com, create an admin account, and follow the Oneprovider registration wizard. Then create a Space, support it from the Oneprovider panel, and invite your users.",
        note: "For production workloads, configure a persistent StorageClass and resource requests/limits in your values files. See the Helm chart README for all available options.",
      },
    ],
  },
];
---

<div class="quick-start-paths">
  <!-- Tab bar -->
  <div class="tab-bar">
    {
      paths.map((path, idx) => {
        const Icon = path.icon;
        return (
          <button class="tab-btn" data-path={path.id} data-idx={idx}>
            <div class="tab-icon-wrap">
              <Icon class="tab-icon" />
            </div>
            <div class="tab-text">
              <p class="tab-label">{path.label}</p>
              <p class="tab-sublabel">{path.sublabel}</p>
            </div>
            <div class="tab-shimmer" />
          </button>
        );
      })
    }
  </div>

  <!-- Content Areas -->
  <div class="paths-content">
    <!-- Idle State -->
    <div id="path-idle" class="path-view active">
      <div class="idle-visual">
        <div class="mouse-icon-wrap">
          <MousePointerClick class="mouse-icon" />
        </div>
        <div class="pulse-arrows">
          <div class="pulse-dot" style="--d: 0"></div>
          <div class="pulse-dot" style="--d: 1"></div>
          <div class="pulse-dot" style="--d: 2"></div>
        </div>
      </div>
      <div class="idle-text">
        <p class="idle-title">Choose your quick start path</p>
        <p class="idle-sub">
          Select one of the options above to see the step-by-step guide.
        </p>
      </div>
    </div>

    <!-- Step Views -->
    {
      paths.map((path) => (
        <div id={`path-${path.id}`} class="path-view">
          <div class="steps-list">
            {path.steps.map((step) => (
              <div class="step-card">
                <div class="step-number-wrap">
                  <span class="step-number">{step.number}</span>
                </div>
                <div class="step-content">
                  <h3 class="step-title">{step.title}</h3>
                  <div
                    class="step-desc step-markdown"
                    set:html={marked.parse(step.description)}
                  />

                  {step.options && (
                    <div class="step-options">
                      {step.options.map((opt) => {
                        const OptIcon = opt.icon;
                        return (
                          <div class="opt-item">
                            <OptIcon class="opt-icon" />
                            <div class="opt-text">
                              <span class="opt-label">{opt.label}:</span>
                              <span class="opt-desc">{opt.text}</span>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}

                  {step.code && (
                    <>
                      {/* prettier-ignore */}
                      <pre class="step-code"><code id={`code-${path.id}`}>{step.code.trim()}</code></pre>
                      <div class="clipboard-btn-container">
                        <div
                          class="clipboard-btn transition-colors"
                          data-clipboard-target={`#code-${path.id}`}
                        >
                          Copy to clipboard <ClipboardCopy class="h-4 w-4" />
                        </div>
                      </div>
                    </>
                  )}

                  {step.note && (
                    <div class="step-alert step-note step-markdown">
                      <Info class="alert-icon" />
                      <div set:html={marked.parse("**Note:** " + step.note)} />
                    </div>
                  )}

                  {step.warning && (
                    <div class="step-alert step-warning step-markdown">
                      <AlertTriangle class="alert-icon" />
                      <div
                        set:html={marked.parse("**Warning:** " + step.warning)}
                      />
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import ClipboardJS from "clipboard";
  new ClipboardJS(".clipboard-btn");
</script>

<script>
  const tabs = document.querySelectorAll(".tab-btn");
  const views = document.querySelectorAll(".path-view");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const pathId = tab.getAttribute("data-path");

      // Update tabs
      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");

      // Update views
      views.forEach((v) => v.classList.remove("active"));
      const activeView = document.getElementById(`path-${pathId}`);
      if (activeView) activeView.classList.add("active");

      // Disable idle state globally once interacted
      document.querySelector(".quick-start-paths")?.classList.add("interacted");
    });
  });
</script>

<!-- FIXME: remove -->
<script>
  setTimeout(() => {
    document.querySelector('.tab-btn[data-idx="1"]')?.click();
  }, 500);
</script>

<style>
  .quick-start-paths {
    --tab-border: var(--od-border, rgba(0, 0, 0, 0.1));
    --tab-bg: var(--od-bg-card, #ffffff);
    --tab-active-bg: var(--od-glow, rgba(230, 52, 26, 0.08));
    --tab-active-border: var(--od-accent, #e6341a);
    --accent: var(--od-accent, #e6341a);
    --text: var(--od-text, #111111);
    --text-muted: var(--od-text-muted, #555555);
    --text-faint: var(--od-text-faint, #999999);
    --bg-input: var(--od-bg-input, #f7f5f2);
  }

  .tab-bar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .tab-bar {
      flex-direction: row;
    }
  }

  .tab-btn {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid var(--tab-border);
    background: var(--tab-bg);
    cursor: pointer;
    text-align: left;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .tab-btn:hover {
    border-color: var(--accent);
  }

  .tab-btn.active {
    background: var(--tab-active-bg);
    border-color: var(--accent);
    box-shadow: 0 0 20px var(--od-glow);
  }

  /* Idle animation for tabs */
  .quick-start-paths:not(.interacted) .tab-btn {
    animation: tab-idle 5.4s infinite ease-in-out;
  }
  .quick-start-paths:not(.interacted) .tab-btn[data-idx="0"] {
    animation-delay: 0s;
  }
  .quick-start-paths:not(.interacted) .tab-btn[data-idx="1"] {
    animation-delay: 0.6s;
  }
  .quick-start-paths:not(.interacted) .tab-btn[data-idx="2"] {
    animation-delay: 1.2s;
  }

  @keyframes tab-idle {
    0%,
    33%,
    100% {
      border-color: var(--tab-border);
      box-shadow: none;
    }
    11% {
      border-color: var(--accent);
      box-shadow: 0 0 18px var(--od-glow-strong);
    }
  }

  .tab-icon-wrap {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-input);
    flex-shrink: 0;
    z-index: 2;
    transition: background 0.3s;
  }

  .tab-btn.active .tab-icon-wrap {
    background: var(--accent);
  }

  .tab-icon {
    width: 1rem;
    height: 1rem;
    color: var(--text-muted);
    transition: color 0.3s;
  }

  .tab-btn.active .tab-icon {
    color: #fff;
  }

  .tab-text {
    z-index: 2;
  }

  .tab-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }

  .tab-btn.active .tab-label {
    color: var(--accent);
  }

  .tab-sublabel {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  /* Shimmer effect when idle */
  .tab-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--od-glow-strong) 50%,
      transparent 100%
    );
    width: 60%;
    transform: translateX(-100%);
    pointer-events: none;
    z-index: 1;
    display: none;
  }

  .quick-start-paths:not(.interacted) .tab-shimmer {
    display: block;
    animation: shimmer 5.4s infinite ease-in-out;
  }
  .tab-btn[data-idx="0"] .tab-shimmer {
    animation-delay: 0s;
  }
  .tab-btn[data-idx="1"] .tab-shimmer {
    animation-delay: 0.6s;
  }
  .tab-btn[data-idx="2"] .tab-shimmer {
    animation-delay: 1.2s;
  }

  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    22%,
    100% {
      transform: translateX(260%);
    }
  }

  /* Content Views */
  .path-view {
    display: none;
  }

  .path-view.active {
    display: block;
    animation: view-in 0.4s ease-out;
  }

  @keyframes view-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Idle State View */
  .idle-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 2.5rem 0 1.25rem;
  }

  .mouse-icon-wrap {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1.25rem;
    background: var(--tab-active-bg);
    border: 1.5px solid var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: float 2s infinite ease-in-out;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  .mouse-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent);
  }

  .pulse-arrows {
    display: flex;
    gap: 1.5rem;
  }

  .pulse-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
    opacity: calc(0.7 - (var(--d) * 0.15));
    animation: pulse-dot 1.2s infinite ease-in-out;
    animation-delay: calc(var(--d) * 0.2s);
  }

  @keyframes pulse-dot {
    0%,
    100% {
      transform: translateY(4px);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .idle-text {
    text-align: center;
    padding-bottom: 2.5rem;
  }

  .idle-title {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .idle-sub {
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  /* Step Cards */
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .step-card {
    background: var(--tab-bg);
    border-radius: 1.25rem;
    border: 1px solid var(--tab-border);
    padding: 1.5rem;
    display: flex;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .step-card {
      padding: 2rem;
    }
  }

  .step-number-wrap {
    flex-shrink: 0;
  }

  .step-number {
    font-size: 2.25rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--accent), #ff6b4a);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .step-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .step-markdown :global(p + p) {
    margin-top: 0.5rem;
  }

  .step-code,
  .step-desc :global(pre) {
    background: var(--bg-input);
    border: 1px solid var(--tab-border);
    border-radius: 0.75rem;
    padding: 1rem;
    font-size: 0.75rem;
    font-family: var(--font-family-mono);
    color: var(--od-accent-3, #ff5533);
    overflow-x: auto;
    margin-bottom: 1rem;
    line-height: 1.6;
    white-space: pre;
  }

  .step-code + .clipboard-btn-container {
    margin-top: -0.75rem;
  }

  .step-desc :global(p + pre) {
    margin-top: 1rem;
  }

  .step-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .opt-item {
    background: var(--bg-input);
    border: 1px solid var(--tab-border);
    border-radius: 0.75rem;
    padding: 1rem;
    display: flex;
    gap: 0.75rem;
  }

  .opt-icon {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .opt-text {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .opt-label {
    font-weight: 500;
    color: var(--text);
    margin-right: 0.25rem;
  }

  .opt-desc {
    color: var(--text-muted);
  }

  .step-alert {
    padding: 1rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .alert-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .step-note {
    background: var(--tab-active-bg);
    border: 1px solid var(--od-glow-strong);
    color: var(--od-accent-3);
  }

  .step-warning {
    background: rgba(234, 179, 8, 0.08);
    border: 1px solid rgba(234, 179, 8, 0.25);
    color: #ca8a04;
  }
</style>
