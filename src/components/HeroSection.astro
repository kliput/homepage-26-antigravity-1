---
const { title, badgeIcon, badgeText, description } = Astro.props;
const HeroBadgeIcon = badgeIcon;
const badgeShown = Boolean(badgeText);
---

<section class="hero-section">
  <div class="hero-grid fadeout-bottom"></div>
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 h-[200px] w-[400px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-10 blur-[40px] sm:h-[400px] sm:w-[600px] sm:blur-[120px]"
    style="background: var(--od-accent);"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-3xl text-center">
    {
      badgeShown && (
        <div class="hero-badge">
          {HeroBadgeIcon && <HeroBadgeIcon class="badge-icon" />}
          {badgeText}
        </div>
      )
    }
    <h1
      class="hero-title container relative z-10 mx-auto max-w-3xl text-center"
    >
      {title}
    </h1>
    {description && <p class="hero-desc container">{description}</p>}
  </div>
</section>

<style>
  .hero-section {
    --fade-size: 5rem;
    position: relative;
    padding-left: 0;
    padding-right: 0;
    padding-top: 4rem;
    padding-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .hero-section {
      padding-top: 7rem;
      padding-bottom: 4rem;
    }
  }

  /* https://www.frontend.fyi/recipes/components-and-css/fadeout-masks */
  .fadeout-bottom {
    mask-image: linear-gradient(
      to top,
      transparent,
      black var(--fade-size, 5rem)
    );
  }

  .hero-grid {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(var(--od-glow, rgba(0, 0, 0, 0.02)) 1px, transparent 1px),
      linear-gradient(
        90deg,
        var(--od-glow, rgba(0, 0, 0, 0.02)) 1px,
        transparent 1px
      );
    background-size: 60px 60px;
  }

  html[data-theme="dark"] .hero-section {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--od-glow-strong);
    background: var(--od-glow);
    color: var(--od-accent-3);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .badge-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.1;
    color: var(--text);
  }

  .hero-desc {
    font-size: clamp(1.125rem, 3vw, 1.25rem);
    color: var(--od-text-muted);
    line-height: 1.6;
  }
</style>
